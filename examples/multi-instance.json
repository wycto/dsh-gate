{
  "defaults": {
    "host": "0.0.0.0",
    "dshHost": "127.0.0.1",
    "autoStart": true,
    "adopt": true,
    "restart": true,
    "stateDir": "~/.dsh-gate"
  },
  "instances": [
    {
      "name": "company",
      "port": 8080,
      "dshPort": 3080,
      "dshHome": "~/.dsh-company",
      "workspace": "~/work/company",
      "users": "~/.dsh-gate/users-company.json"
    },
    {
      "name": "personal",
      "port": 3082,
      "dshPort": 3081,
      "dshHome": "~/.dsh",
      "workspace": "~/work/personal",
      "users": "~/.dsh-gate/users-personal.json"
    }
  ]
}