# 带 systemd 的验收镜像：用来验证 service install 在真实服务管理器下的行为。
#
# 为什么需要它：网关的部署形态里，`sudo dsh-gate service install` 写出的 systemd
# 单元只有真正被 systemd 加载过才算验证过。普通容器里没有 init，`systemctl` 是假的；
# 而「单元里的 ExecStart / WorkingDirectory 对不对」恰恰是最容易出问题、又在开发机
# 上完全测不到的地方（实测就发现过单元 WorkingDirectory 留在家目录）。
FROM ubuntu:24.04
RUN apt-get update -qq && \
    apt-get install -y -qq systemd systemd-sysv curl ca-certificates procps iproute2 >/dev/null && \
    rm -rf /var/lib/apt/lists/*
# systemd 作为 PID 1 时用 SIGRTMIN+3 停机，否则 docker stop 会超时强杀
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
